OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=gemma3:latest
SYSTEM_PROMPT_FILE=./prompts/system-custom.md

POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgres://rag:replace-with-a-local-password@localhost:5432/rag?sslmode=disable

EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_DIM=768
EMBEDDING_MODEL=nomic-embed-text
# Task prefixes are off by default: they gave no significant gain on this
# corpus (see README). Quote them, the trailing space matters. Changing the
# document prefix requires re-ingesting.
# EMBEDDING_QUERY_PREFIX="search_query: "
# EMBEDDING_DOCUMENT_PREFIX="search_document: "
INGEST_DIR=./documents
PROCESSED_DIR=./documents/processed
HTTP_ADDR=127.0.0.1:8080
IMAGES_DIR=./documents/images
VISION_MODEL=

# Cosine-similarity floor for retrieved chunks (default 0.55, tuned on the
# dev half with `go run ./cmd/eval -split dev -sweep`). 0 disables it.
# RETRIEVAL_MIN_SCORE=0.55

# Dedicated database for cmd/eval; it is truncated on every run.
# Start it with: docker compose --profile eval up -d eval-db
EVAL_DATABASE_URL=postgres://rag:eval@localhost:5433/rag_eval?sslmode=disable
